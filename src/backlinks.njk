---
permalink: "/backlinks.html"
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Moved to topics — {{ site.title }}</title>
  <meta name="robots" content="noindex">
  <link rel="canonical" href="{{ site.url }}/topics.html">
  <script>
    // Backlinks became topics. Old links (/backlinks.html?term=Love), e.g. in feed readers,
    // are sent to the matching topic page, or to the topic list if the term has no page.
    var slugs = {{ collections.topics | topicRedirects | dump | safe }};
    var term = (new URLSearchParams(location.search).get("term") || "").trim().toLowerCase();
    location.replace(slugs[term] ? "/topics/" + slugs[term] + ".html" : "/topics.html");
  </script>
  <noscript><meta http-equiv="refresh" content="0; url=/topics.html"></noscript>
</head>
<body>
  <p>This page has moved to <a href="/topics.html">topics</a>.</p>
</body>
</html>
